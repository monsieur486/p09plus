# Gabarit à copier en .env pour le développement local. Sans lui, les valeurs par défaut
# écrites dans docker-compose.yml et dans les application.yml s'appliquent.
#
# Les identifiants dont se sert le cluster ne figurent pas ici : ils sont portés par le
# Secret k8s/00-secrets.yaml. Le nombre d'instances non plus : il est écrit dans le champ
# `replicas` de chaque Deployment, kubectl n'ayant pas d'équivalent de ce fichier.

# Configuration base de données PostgreSQL
POSTGRES_DB=patientsdb
POSTGRES_USER=patient_user
POSTGRES_PASSWORD=patient_pass

# Configuration base de données MongoDB
MONGO_INITDB_ROOT_USERNAME=notes_user
MONGO_INITDB_ROOT_PASSWORD=notes_password

# Configuration de l'application
APP_USERNAME=app_user
APP_PASSWORD=app_password
