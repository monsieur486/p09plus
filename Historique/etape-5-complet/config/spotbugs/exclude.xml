<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exclusions SpotBugs maison — chaque entrée est un faux positif assumé et justifié.
  Toute nouvelle exclusion doit porter son commentaire : on neutralise au cas par cas,
  jamais une règle entière « pour avoir le rapport vert ».
-->
<FindBugsFilter>

    <!--
      EI_EXPOSE_REP / EI_EXPOSE_REP2 sur les DTO : ce sont des objets de transport, dont
      les accesseurs sont générés par Lombok et dont les collections sont sérialisées puis
      relâchées immédiatement. Défendre la référence n'apporterait rien ici, et imposerait
      d'écrire à la main des accesseurs copiant les collections dans chaque DTO.
    -->
    <Match>
        <Package name="~.*\.dto"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      EI_EXPOSE_REP2 sur les composants gérés par Spring : conserver la référence d'un
      collaborateur reçu par constructeur est le principe même de l'injection de
      dépendances. Le conteneur garantit l'unicité de ces beans, il n'y a pas de
      représentation interne à protéger.
    -->
    <Match>
        <Or>
            <Package name="~.*\.dbchangelogs"/>
            <Package name="~.*\.service"/>
            <Package name="~.*\.configuration"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      CRLF_INJECTION_LOGS (FindSecBugs) : la règle signale tout paramètre journalisé sans
      assainissement. Ici les seules valeurs tracées sont des identifiants numériques
      (Long), des statuts HTTP et des constantes internes — aucune chaîne fournie par un
      utilisateur, donc aucun retour chariot injectable. Les messages sont par ailleurs
      systématiquement paramétrés avec {}, jamais concaténés.
      À réexaminer si l'on venait à journaliser une saisie libre.
    -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

</FindBugsFilter>
